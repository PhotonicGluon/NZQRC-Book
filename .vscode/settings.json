{
    // Editor settings
    "editor.formatOnSaveMode": "modificationsIfAvailable",
    "editor.wordWrap": "bounded",

    // File association settings
    "files.exclude": {
        "**/*-blx.bib": true,
        "**/*.aux": true,
        "**/*.bbl": true,
        "**/*.blg": true,
        "**/*.fdb_latexmk": true,
        "**/*.fls": true,
        "**/*.idx": true,
        "**/*.ilg": true,
        "**/*.ind": true,
        "**/*.log": true,
        "**/*.out": true,
        "**/*.run.xml": true,
        "**/*.synctex.gz": true,
        "**/*.toc": true,
        "**/.ipynb_checkpoints": true,
        "**/__pycache__": true
    },
    "files.eol": "\n",
    "files.associations": {
        "*.tex": "latex"
    },

    // Latex settings
    "latex-workshop.view.pdf.invert": 0.9,
    "latex-workshop.latex.autoBuild.run": "onSave",
    "latex-workshop.latex.recipes": [
        {
            "name": "latexmk",
            "tools": [
                "latexmk"
            ]
        },
        {
            "name": "latexmk (latexmkrc)",
            "tools": [
                "latexmk_rconly"
            ]
        },
        {
            "name": "latexmk (lualatex)",
            "tools": [
                "lualatexmk"
            ]
        },
        {
            "name": "latexmk (xelatex)",
            "tools": [
                "xelatexmk"
            ]
        },
        {
            "name": "pdflatex -> bibtex -> pdflatex * 2",
            "tools": [
                "pdflatex",
                "bibtex",
                "pdflatex",
                "pdflatex"
            ]
        },
        {
            "name": "Compile Rnw files",
            "tools": [
                "rnw2tex",
                "latexmk"
            ]
        },
        {
            "name": "Compile Jnw files",
            "tools": [
                "jnw2tex",
                "latexmk"
            ]
        },
        {
            "name": "Compile Pnw files",
            "tools": [
                "pnw2tex",
                "latexmk"
            ]
        },
        {
            "name": "tectonic",
            "tools": [
                "tectonic"
            ]
        }
    ],
    "latex-workshop.synctex.afterBuild.enabled": true,
    "latex-workshop.bibtex-format.tab": "4 spaces",
    "latex-workshop.intellisense.bibtexJSON.replace": {},
    
    // Spell checker settings
    "cSpell.language": "en-GB",
    "cSpell.words": [
        "arity",
        "biconditional",
        "biconditionals",
        "bijectivity",
        "consts",
        "devcontainer",
        "equinumerosity",
        "extensionality",
        "Flaticon",
        "Georg",
        "getbbox",
        "getpixel",
        "Hasse",
        "imgen",
        "injectivity",
        "ipylab",
        "ipynb",
        "lettrine",
        "magics",
        "manim",
        "mobject",
        "mobjects",
        "Noether",
        "nullary",
        "nzqrc",
        "papermill",
        "poset",
        "posets",
        "qrcode",
        "surjectivity",
        "tlmgr",
        "typer",
        "ukasiewicz",
        "wff",
        "wffs",
        "zahlen",
        "Zassenhaus"
    ],

    // Other settings
    "autoDocstring.docstringFormat": "google-notypes",
    "wordcounter.side.left": [
        "word",
        "paragraph",
        "readingtime"
    ],
}